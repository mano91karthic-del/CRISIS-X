VITE_API_BASE_URL=http://localhost:8000

# Phase 11 (optional): a vector tile style URL for real-world basemap
# context (roads/coastlines/place names) behind the dashboard's own
# data layers. Unset by default -- the dashboard ships with zero
# external imagery, fully offline-capable, per ADR 0012.
# VITE_BASEMAP_STYLE_URL=

# Phase 11 (optional, E2E-only): exposes the live MapLibre map instance
# on window.__map so the Playwright smoke spec can assert on its
# sources/layers. Never set this for a real deployment.
# VITE_EXPOSE_MAP_FOR_TESTS=true
